rules_version = '2';

// Reglas de seguridad de Firestore (paso 6 de la guía).
// Se copian y pegan en Firebase: Firestore Database > Reglas > Publicar.
service cloud.firestore {
  match /databases/{database}/documents {

    // Reemplazá PEGAR_TU_EMAIL por el mail del usuario administrador.
    function esAdmin() {
      return request.auth != null
        && request.auth.token.email == "gervasiobernal@gmail.com";
    }

    // Configuración del torneo: todos la leen, solo el admin la cambia.
    match /torneo/config {
      allow read: if true;
      allow write: if esAdmin();
    }

    // Golpes de cada partido: todos leen; escribe quien abrió la app
    // (sesión anónima automática). Se limita el tamaño del documento.
    match /scores/{matchId} {
      allow read: if true;
      allow write: if request.auth != null
        && matchId.size() < 24
        && (request.resource == null || request.resource.data.size() <= 18);
    }

    // Todo lo demás, cerrado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
